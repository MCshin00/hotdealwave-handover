# 환경변수 파일. 예시 파일은 env.example처럼 이 규칙에 걸리지 않는 이름을 쓴다
.env
.env.*
*.env
*.env.*

# 생성 결과물. 명령 하나로 다시 만든다
out/

# 예시 작업 폴더: 결과와 검증 출력은 커밋하고, init이 받는 대상 코드와 지시 파일은 커밋하지 않는다
!/examples/hotdealwave/out/
/examples/*/source/
/examples/*/AGENTS.md
/examples/*/CLAUDE.md

# 개인 작업 파일
.local/

# 개인 도구 설정
.claude/settings.local.json

# Python (scripts/)
__pycache__/
*.py[cod]

.gradle/
build/

# 운영체제
.DS_Store
Thumbs.db
