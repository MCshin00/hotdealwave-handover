{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "분석 대상",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^https://github[.]com/[^/]+/[^/]+$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    }
  },
  "required": [
    "schemaVersion",
    "name",
    "repository",
    "commit"
  ],
  "additionalProperties": false
}
